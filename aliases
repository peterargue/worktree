#!/usr/bin/env bash

# worktree - manage git worktrees within the current repo under .worktrees/

worktree() {
    local cmd="$1"
    shift

    case "$cmd" in
        list)   _worktree_list "$@" ;;
        add)    _worktree_add "$@" ;;
        resume) _worktree_resume "$@" ;;
        remove) _worktree_remove "$@" ;;
        root)   _worktree_root "$@" ;;
        *)
            echo "Usage: worktree <list|add|resume|remove|root> [args]"
            echo ""
            echo "Commands:"
            echo "  list                List all worktrees"
            echo "  add <branch>        Add a new worktree"
            echo "  resume [<branch>]   cd into an existing worktree"
            echo "  remove [--force] <branch>"
            echo "                      Remove a worktree. Use --force to remove"
            echo "                      even with uncommitted changes."
            echo "  root                cd to the main repo root"
            return 1
            ;;
    esac
}

# Interactive arrow-key picker. Prints the 1-based index of the selected item.
# Usage: selection=$(_worktree_picker [--initial N] "item1" "item2" ...)
_worktree_picker() {
    local initial=1
    if [[ "$1" == "--initial" ]]; then
        initial="$2"
        shift 2
    fi
    local items=("$@")
    local count=${#items[@]}
    local cur=$initial
    local key

    # Hide cursor
    printf '\e[?25l' >/dev/tty

    # Draw initial list
    local i=1
    while [[ $i -le $count ]]; do
        if [[ $i -eq $cur ]]; then
            printf '\e[1;36m  > %s\e[0m\n' "${items[$i]}" >/dev/tty
        else
            printf '    %s\n' "${items[$i]}" >/dev/tty
        fi
        i=$((i + 1))
    done

    while true; do
        # Read a single keypress (zsh uses -k, bash uses -n)
        if [[ -n "$ZSH_VERSION" ]]; then
            IFS= read -rsk1 key < /dev/tty
        else
            IFS= read -rsn1 key < /dev/tty
        fi
        if [[ "$key" == $'\x1b' ]]; then
            if [[ -n "$ZSH_VERSION" ]]; then
                IFS= read -rsk2 key < /dev/tty
            else
                IFS= read -rsn2 key < /dev/tty
            fi
            case "$key" in
                '[A') [[ $cur -gt 1 ]] && cur=$((cur - 1)) ;;     # Up
                '[B') [[ $cur -lt $count ]] && cur=$((cur + 1)) ;; # Down
            esac
        elif [[ "$key" == "" || "$key" == $'\n' ]]; then
            # Enter pressed — show cursor and print result
            printf '\e[?25h' >/dev/tty
            echo "$cur"
            return 0
        elif [[ "$key" == "q" ]]; then
            # Quit
            printf '\e[?25h' >/dev/tty
            return 1
        fi

        # Move cursor up to redraw
        printf "\e[${count}A" >/dev/tty

        # Redraw list
        i=1
        while [[ $i -le $count ]]; do
            printf '\e[2K' >/dev/tty  # Clear line
            if [[ $i -eq $cur ]]; then
                printf '\e[1;36m  > %s\e[0m\n' "${items[$i]}" >/dev/tty
            else
                printf '    %s\n' "${items[$i]}" >/dev/tty
            fi
            i=$((i + 1))
        done
    done
}

# Sanitize branch name for use as a directory name.
# Replaces /, ., and other invalid filename characters with -
_worktree_sanitize_dirname() {
    echo "$1" | sed 's/[\/\.@#$%^&*!~`|\\:;<>?]/-/g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//'
}

_worktree_list() {
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Error: Not in a git repository"
        return 1
    fi

    local main_worktree
    main_worktree=$(_worktree_main_root)

    local current_wt
    current_wt=$(_worktree_current)

    echo "Current worktrees:"
    git worktree list --porcelain | awk -v main_path="$main_worktree" -v current="$current_wt" '
    /^worktree / { path = substr($0, 10) }
    /^branch / { branch = substr($0, 8); gsub(/^refs\/heads\//, "", branch) }
    /^$/ { print_entry(); path = ""; branch = "" }
    END { print_entry() }
    function print_entry() {
        if (!path || path == main_path) return
        label = branch ? branch : "(detached)"
        n = split(path, parts, "/")
        dirname = parts[n]
        if (current != "" && dirname == current) {
            printf "  \033[1;36m* %-30s %s\033[0m\n", label, path
        } else {
            printf "    %-30s %s\n", label, path
        }
    }'
}

_worktree_add() {
    if [[ -z "$1" ]]; then
        echo "Usage: worktree add <branch-name>"
        return 1
    fi

    local branch_name="$1"
    local dir_name
    dir_name=$(_worktree_sanitize_dirname "$branch_name")

    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Error: Not in a git repository"
        return 1
    fi

    local repo_root
    repo_root=$(_worktree_main_root)
    local worktree_dir="${repo_root}/.worktrees/${dir_name}"

    # If worktree already exists, just cd into it
    if [[ -d "$worktree_dir" ]]; then
        echo "Worktree already exists at: $worktree_dir"
        cd "$worktree_dir" || return 1
        return 0
    fi

    # Ensure .worktrees/ is in .gitignore
    _worktree_ensure_gitignore "$repo_root"

    # Create the worktrees directory
    mkdir -p "${repo_root}/.worktrees"

    # Determine how to create the worktree
    if git show-ref --verify --quiet "refs/heads/${branch_name}"; then
        echo "Branch '${branch_name}' exists locally. Creating worktree..."
        git worktree add "$worktree_dir" "$branch_name"
    elif git show-ref --verify --quiet "refs/remotes/origin/${branch_name}"; then
        echo "Branch '${branch_name}' exists on remote. Creating worktree and tracking branch..."
        git worktree add "$worktree_dir" -b "$branch_name" "origin/${branch_name}"
    else
        local default_branch
        default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
        if [[ -z "$default_branch" ]]; then
            for branch in main master; do
                if git show-ref --verify --quiet "refs/remotes/origin/${branch}"; then
                    default_branch="$branch"
                    break
                fi
            done
        fi

        if [[ -z "$default_branch" ]]; then
            echo "Error: Could not determine default branch"
            return 1
        fi

        echo "Creating new branch '${branch_name}' from '${default_branch}'..."
        git worktree add "$worktree_dir" -b "$branch_name" "origin/${default_branch}"
    fi

    if [[ $? -ne 0 ]]; then
        echo "Failed to create worktree"
        return 1
    fi

    echo "Worktree created at: $worktree_dir"

    # Copy .claude directory if it doesn't already exist, then sync config files
    if [[ -d "${repo_root}/.claude" ]]; then
        if [[ ! -d "${worktree_dir}/.claude" ]]; then
            cp -r "${repo_root}/.claude" "${worktree_dir}/.claude"
            echo "Copied .claude directory into worktree"
        else
            # Sync key config files into existing .claude dir
            for f in CLAUDE.md settings.local.json; do
                if [[ -f "${repo_root}/.claude/${f}" ]]; then
                    cp "${repo_root}/.claude/${f}" "${worktree_dir}/.claude/${f}"
                fi
            done
            echo "Updated .claude/CLAUDE.md and settings.local.json"
        fi
    fi

    cd "$worktree_dir" || return 1
}

_worktree_resume() {
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Error: Not in a git repository"
        return 1
    fi

    local repo_root
    repo_root=$(_worktree_main_root)
    local worktrees_dir="${repo_root}/.worktrees"

    if [[ ! -d "$worktrees_dir" ]] || [[ -z "$(ls -A "$worktrees_dir" 2>/dev/null)" ]]; then
        echo "No worktrees found"
        return 1
    fi

    # If a branch name is provided, cd directly into it
    if [[ -n "$1" ]]; then
        if [[ "$1" == "[root]" ]]; then
            cd "$repo_root" || return 1
            return 0
        fi

        local dir_name
        dir_name=$(_worktree_sanitize_dirname "$1")
        local worktree_dir="${worktrees_dir}/${dir_name}"

        if [[ ! -d "$worktree_dir" ]]; then
            echo "Worktree not found: $worktree_dir"
            return 1
        fi

        cd "$worktree_dir" || return 1
        return 0
    fi

    # No branch specified — show a picker
    local dirs=("$repo_root")
    local branches=("[root]")
    for dir in "$worktrees_dir"/*/; do
        [[ -d "$dir" ]] || continue
        dirs+=("$dir")
        branches+=("$(basename "$dir")")
    done

    if [[ ${#branches[@]} -le 1 ]]; then
        echo "No worktrees found"
        return 1
    fi

    # Pre-select the current worktree if inside one
    local initial=1
    local current_wt
    current_wt=$(_worktree_current)
    if [[ -n "$current_wt" ]]; then
        local idx=1
        while [[ $idx -le ${#branches[@]} ]]; do
            if [[ "${branches[$idx]}" == "$current_wt" ]]; then
                initial=$idx
                break
            fi
            idx=$((idx + 1))
        done
    fi

    local selection
    selection=$(_worktree_picker --initial "$initial" "${branches[@]}")
    [[ -z "$selection" ]] && return 1

    cd "${dirs[$selection]}" || return 1
}

_worktree_root() {
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Error: Not in a git repository"
        return 1
    fi

    local main_root
    main_root=$(_worktree_main_root)

    if [[ "$PWD" == "$main_root" ]]; then
        return 0
    fi

    cd "$main_root" || return 1
}

# Resolve the main repo root (the first worktree, i.e. the non-linked one)
_worktree_main_root() {
    git worktree list --porcelain | head -1 | sed 's/^worktree //'
}

# Detect if the current directory is inside a .worktrees/ worktree.
# If so, prints the worktree directory name. Returns 1 if not in a worktree.
_worktree_current() {
    local toplevel
    toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
    local main_root
    main_root=$(_worktree_main_root)

    # If we're in the main repo, not a worktree
    [[ "$toplevel" == "$main_root" ]] && return 1

    # Check if this worktree lives under .worktrees/
    case "$toplevel" in
        "${main_root}/.worktrees/"*)
            basename "$toplevel"
            return 0
            ;;
    esac
    return 1
}

_worktree_remove() {
    local force=false
    local approve=false
    local branch_name=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force) force=true; shift ;;
            -a|--approve) approve=true; shift ;;
            *)       branch_name="$1"; shift ;;
        esac
    done

    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Error: Not in a git repository"
        return 1
    fi

    local main_root
    main_root=$(_worktree_main_root)

    # If no branch specified, try to infer from current worktree
    if [[ -z "$branch_name" ]]; then
        local current_wt
        current_wt=$(_worktree_current)
        if [[ -n "$current_wt" ]]; then
            branch_name="$current_wt"
            echo "Detected current worktree: $branch_name"
        else
            echo "Usage: worktree remove [--force] [<branch-name>]"
            echo "  (omit branch name when inside a worktree to remove the current one)"
            return 1
        fi
    fi

    local dir_name
    dir_name=$(_worktree_sanitize_dirname "$branch_name")
    local worktree_dir="${main_root}/.worktrees/${dir_name}"

    # Check if worktree exists
    if [[ ! -d "$worktree_dir" ]]; then
        echo "Worktree not found: $worktree_dir"
        return 1
    fi

    # Confirm removal
    if [[ "$approve" != true ]]; then
        local will_delete_branch=""
        if git branch --merged | grep -q "^\s*${branch_name}$"; then
            will_delete_branch=" and branch '${branch_name}' (already merged)"
        fi
        echo "Remove worktree '${dir_name}'${will_delete_branch}?"
        echo -n "Continue? [y/N] "
        read -r confirm
        if [[ ! "$confirm" =~ ^[yY]([eE][sSpPaA])?$ ]]; then
            echo "Aborted"
            return 0
        fi
    fi

    # If we're inside the worktree being removed, cd to main root first
    local current_wt
    current_wt=$(_worktree_current)
    if [[ "$current_wt" == "$dir_name" ]]; then
        echo "Currently in this worktree, switching to main repo..."
        cd "$main_root" || return 1
    fi

    # Remove the worktree
    echo "Removing worktree: $worktree_dir"
    if [[ "$force" == true ]]; then
        git worktree remove -f "$worktree_dir"
    else
        git worktree remove "$worktree_dir"
    fi

    if [[ $? -ne 0 ]]; then
        echo "Failed to remove worktree (use --force to force removal)"
        return 1
    fi

    echo "Worktree removed successfully"

    # Delete the branch if it was merged
    if git branch --merged | grep -q "^\s*${branch_name}$"; then
        git branch -d "$branch_name" 2>/dev/null
        if [[ $? -eq 0 ]]; then
            echo "Branch '${branch_name}' deleted (was merged)"
        fi
    fi
}

_worktree_ensure_gitignore() {
    local repo_root="$1"
    local gitignore="${repo_root}/.gitignore"

    if [[ ! -f "$gitignore" ]]; then
        echo ".worktrees/" > "$gitignore"
        echo "Created .gitignore with .worktrees/"
        return
    fi

    if ! grep -q '^\.worktrees/$' "$gitignore" && ! grep -q '^\.worktrees$' "$gitignore"; then
        echo "" >> "$gitignore"
        echo ".worktrees/" >> "$gitignore"
        echo "Added .worktrees/ to .gitignore"
    fi
}

# List existing worktree directory names for completions
_worktree_names() {
    local repo_root
    repo_root=$(_worktree_main_root 2>/dev/null) || return
    local worktrees_dir="${repo_root}/.worktrees"
    if [[ -d "$worktrees_dir" ]]; then
        for dir in "$worktrees_dir"/*/; do
            [[ -d "$dir" ]] && basename "$dir"
        done
    fi
}

# Bash completion
if [[ -n "$BASH_VERSION" ]]; then
    _worktree_completions() {
        local cur prev commands
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
        commands="list add resume remove root"

        case "$prev" in
            worktree)
                COMPREPLY=($(compgen -W "$commands" -- "$cur"))
                ;;
            resume|remove)
                COMPREPLY=($(compgen -W "$(_worktree_names)" -- "$cur"))
                ;;
        esac
    }
    complete -F _worktree_completions worktree
fi

# Zsh completion
if [[ -n "$ZSH_VERSION" ]]; then
    _worktree_completions() {
        local -a subcmds
        subcmds=(
            'list:List all worktrees'
            'add:Add a new worktree'
            'resume:Switch to an existing worktree'
            'remove:Remove a worktree'
            'root:cd to the main repo root'
        )

        _arguments '1:command:->cmds' '*:arg:->args'

        case "$state" in
            cmds)
                _describe 'command' subcmds
                ;;
            args)
                case "${words[2]}" in
                    resume|remove)
                        local -a names
                        names=($(_worktree_names))
                        _describe 'worktree' names
                        ;;
                esac
                ;;
        esac
    }
    compdef _worktree_completions worktree
fi
